# Copy values into your shell before syncing Capacitor.
# Example (Windows PowerShell):
#   $env:CAPACITOR_SERVER_URL="http://192.168.1.10:3000"
#   npm run cap:sync
#
# Android emulator → host machine Next server:
#   $env:CAPACITOR_SERVER_URL="http://10.0.2.2:3000"
#
# Production:
#   $env:CAPACITOR_SERVER_URL="https://your-deployed-app.example"

CAPACITOR_SERVER_URL=http://10.0.2.2:3000
